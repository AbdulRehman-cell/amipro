# ---------------------------------------------------
# Server configuration
# ---------------------------------------------------

# Port the Express server listens on.
# Render sets this automatically in production; used locally otherwise.
PORT=10000

# Environment mode: development | production | test
NODE_ENV=development

# ---------------------------------------------------
# Database
# ---------------------------------------------------

# MongoDB connection string.
# Local (docker-compose): mongodb://mongo:27017/amipro
# Production: use MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/amipro?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/amipro

# ---------------------------------------------------
# CORS
# ---------------------------------------------------

# Comma-separated list of allowed origins for the API.
# Example: https://amipro.onrender.com,https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------
# Optional: add any API keys / secrets your app uses below
# ---------------------------------------------------
# JWT_SECRET=change-me-to-a-long-random-string
# SESSION_SECRET=change-me-to-a-long-random-string